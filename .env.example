# Demo mode is the reliable event default. It uses clearly labelled scenarios
# stored in data/demo/scenarios.json and does not require a database.
ORCA_DATA_MODE=demo

# Optional PostgreSQL configuration. Set ORCA_DATA_MODE=database only after
# applying backend/database/schema.sql and seeding scenario records.
DATABASE_URL=postgresql://orca_user:orca_password@localhost:5432/orca_ecosystem

# Comma-separated exact frontend origins. Replace with the deployed frontend URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
